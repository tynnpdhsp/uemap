ENV=production

# MongoDB (tên service trong docker-compose.prod.yml)
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=production_db

# MinIO (đổi key mạnh trên production)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=ban-do-uploads
MINIO_USE_SSL=false

# JWT — bắt buộc đổi secret dài, ngẫu nhiên
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=480

# SMTP (Gmail: dùng App Password, không dùng mật khẩu đăng nhập thường)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=Ban do sinh vien su pham
SMTP_FROM_EMAIL=your-email@gmail.com

# CORS — thêm URL frontend production (IP hoặc domain)
# Ví dụ: http://103.162.30.79:3000
CORS_ORIGINS=http://103.162.30.79:3000

# Bản đồ mặc định (HCMUE / khu vực dự án)
MAP_DEFAULT_CENTER_LAT=10.7628
MAP_DEFAULT_CENTER_LNG=106.6824
MAP_DEFAULT_ZOOM=15
