# =============================================================================
# Sao chép file này thành .env và điền giá trị thực tế.
# KHÔNG commit file .env chứa secret lên Git.
# =============================================================================

# --- Môi trường ---
# Chỉ nhận giá trị: dev | production
ENV=dev

# --- MongoDB ---
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=ban_do_sv_sp

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ban-do-uploads
MINIO_USE_SSL=false

# --- JWT ---
JWT_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Ban do sinh vien su pham
SMTP_FROM_EMAIL=your-email@gmail.com

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Frontend ---
VITE_API_BASE_URL=/api

# --- Cấu hình bản đồ mặc định ---
MAP_DEFAULT_CENTER_LAT=10.7628
MAP_DEFAULT_CENTER_LNG=106.6824
MAP_DEFAULT_ZOOM=15

# --- Seed tài khoản quản trị ---
ADMIN_SEED_USERNAME=sysadmin
ADMIN_SEED_PASSWORD=your-admin-password
