pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = "bin05"
        FE_IMAGE = "frontend"
        BE_IMAGE = "backend"
        BUILD_TAG = "${env.BUILD_NUMBER}"
        SERVER_IP = "103.162.30.79"
    }

    stages {
        stage('Checkout Code') {
            when {
                anyOf { branch 'main'; branch 'staging'; }
            }
            steps {
                checkout scm
            }
        }

        stage('Code Formatting & Linting') {
            when {
                anyOf { branch 'main'; branch 'staging'; }
            }
            steps {
                echo "Running Linter for Frontend & Backend..."
                script {
                    docker.image('node:20-alpine').inside {
                        sh "cd frontend && npm ci && npm run lint"
                    }
                    docker.image('python:3.11-slim').inside {
                        sh "cd backend && pip install --break-system-packages ruff && ruff check ."
                    }
                }
            }
        }

        stage('Frontend Tests (Unit & Integration)') {
            when {
                anyOf { branch 'main'; branch 'staging'; }
            }
            steps {
                echo "Running Frontend Tests..."
                script {
                    docker.image('node:20-alpine').inside {
                        sh "cd frontend && npm ci && npm run test:coverage"
                        sh "cd frontend && npm run test:integration"
                    }
                }
            }
        }

        stage('Backend Tests (Unit, Integration, E2E)') {
            when {
                anyOf { branch 'main'; branch 'staging'; }
            }
            steps {
                echo "Running Backend Tests..."
                script {
                    def networkName = "test_net_${BUILD_TAG}"
                    def mongoName = "mongo_test_db_${BUILD_TAG}"

                    sh "docker network create ${networkName}"
                    sh "docker run -d --name ${mongoName} --network ${networkName} --tmpfs /data/db mongo:6.0"

                    try {
                        def pipCache = "${WORKSPACE}/.pip-cache"
                        docker.image('python:3.11-slim').inside("--network=${networkName} -v ${pipCache}:/root/.cache/pip") {
                            sh """
                                cd backend
                                pip install -r requirements.txt pytest-cov

                                echo "Waiting for MongoDB..."
                        for i in \$(seq 1 60); do
                            python -c "
import pymongo, sys
try:
    pymongo.MongoClient('mongodb://${mongoName}:27017', serverSelectionTimeoutMS=1000).server_info()
    sys.exit(0)
except: sys.exit(1)
" && echo "MongoDB ready!" && break
                            echo "  attempt \${i}/60..."
                            sleep 1
                        done

                                export MONGO_URI=mongodb://${mongoName}:27017/test_db
                                pytest tests/unit tests/integration tests/e2e --cov=app --cov-report=xml:coverage.xml
                            """
                        }
                    } finally {
                        sh "docker rm -f ${mongoName} || true"
                        sh "docker network rm ${networkName} || true"
                    }
                }
            }
        }

        stage('SonarQube Code Analysis') {
            when {
                anyOf { branch 'main'; branch 'staging'; }
            }
            steps {
                echo "Initiating SonarQube Scanning..."
                script {
                    withSonarQubeEnv('SonarQube') {
                        docker.image('sonarsource/sonar-scanner-cli:latest').inside('--network=devops-net') {
                            sh '''
                                sonar-scanner \
                                -Dsonar.projectKey=app-key \
                                -Dsonar.sources=frontend,backend \
                                -Dsonar.javascript.lcov.reportPaths=frontend/coverage/lcov.info
                            '''
                        }
                    }
                }
            }
        }

        stage('Build & Push Images to Docker Hub') {
            when {
                branch 'main'
            }
            steps {
                script {
                    sh "docker build -f frontend/Dockerfile.prod -t ${DOCKER_REGISTRY}/${FE_IMAGE}:${BUILD_TAG} -t ${DOCKER_REGISTRY}/${FE_IMAGE}:latest ./frontend"
                    sh "docker build -f backend/Dockerfile.prod -t ${DOCKER_REGISTRY}/${BE_IMAGE}:${BUILD_TAG} -t ${DOCKER_REGISTRY}/${BE_IMAGE}:latest ./backend"
                }

                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                    sh "docker push ${DOCKER_REGISTRY}/${FE_IMAGE}:${BUILD_TAG}"
                    sh "docker push ${DOCKER_REGISTRY}/${FE_IMAGE}:latest"
                    sh "docker push ${DOCKER_REGISTRY}/${BE_IMAGE}:${BUILD_TAG}"
                    sh "docker push ${DOCKER_REGISTRY}/${BE_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Server via SSH') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'server-creds', usernameVariable: 'SSH_USER', passwordVariable: 'SSH_PASS')]) {
                    script {
                        docker.image('alpine:latest').inside {
                            sh "apk add --no-cache sshpass openssh-client"
                            sh "sshpass -p \$SSH_PASS ssh -p 26266 -o StrictHostKeyChecking=no root@${SERVER_IP} 'mkdir -p ~/app'"
                            sh "sshpass -p \$SSH_PASS scp -P 26266 -o StrictHostKeyChecking=no docker/docker-compose.prod.yml root@${SERVER_IP}:~/app/docker-compose.yml"
                            sh """
                                sshpass -p \$SSH_PASS ssh -p 26266 -o StrictHostKeyChecking=no root@${SERVER_IP} "
                                    cd ~/app &&
                                    docker compose pull &&
                                    docker compose up -d
                                "
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}